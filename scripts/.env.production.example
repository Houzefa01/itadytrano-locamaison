# ═══════════════════════════════════════════════════════════════
#  ItadyTrano — Variables d'environnement (PRODUCTION)
#  ⚠  NE JAMAIS COMMITER CE FICHIER DANS GIT
#  Copier vers .env et adapter les valeurs
# ═══════════════════════════════════════════════════════════════

# ── Base de données PostgreSQL ──────────────────────────────
DB_NAME=itadytrano
DB_USER=itadyuser
DB_PASSWORD=<GENERER_UN_MOT_DE_PASSE_FORT>

# ── Authentification JWT ────────────────────────────────────
# Générer avec : openssl rand -hex 64
JWT_SECRET=<GENERER_UN_SECRET_AU_MOINS_64_HEX>
JWT_EXPIRATION=86400000

# ── Configuration Web ───────────────────────────────────────
# URL autorisées en CORS (séparées par des virgules si plusieurs)
ALLOWED_ORIGINS=https://itadytrano.mg,https://www.itadytrano.mg
# Port d'exposition du frontend Nginx
WEB_PORT=8088

# ── Email (Gmail SMTP — facultatif) ─────────────────────────
MAIL_USERNAME=mon-email@gmail.com
MAIL_PASSWORD=<mot-de-passe-application-gmail>

# ── Orange SMS API (facultatif) ─────────────────────────────
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_NUMBER=

# ── Paiement (webhook secret) ───────────────────────────────
# Générer avec : openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=<GENERER_UN_SECRET>

# ── Uploads ─────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads

# ── Email (activer/désactiver) ──────────────────────────────
EMAIL_ENABLED=false
