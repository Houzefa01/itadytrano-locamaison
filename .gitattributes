# Normalisation des fins de ligne : LF partout (évite le churn CRLF<->LF).
* text=auto eol=lf

# Scripts Windows en CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Fichiers binaires (jamais de conversion d'EOL)
*.jar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.odt  binary
*.docx binary
